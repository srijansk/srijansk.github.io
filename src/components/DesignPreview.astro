---
/**
 * A small, live rendering of a design piece for its card: real type and the
 * site's own colours rather than a screenshot, so it stays crisp, follows the
 * dark scheme, and shows the idea at a glance. Decorative: the card's title
 * and summary carry the meaning, so the preview is hidden from screen readers
 * and holds nothing focusable.
 */
interface Props {
  kind: 'review' | 'delivery';
}
const { kind } = Astro.props;
---

<div class:list={['dp', `dp--${kind}`]} aria-hidden="true">
  {kind === 'review' && (
    <>
      <div class="dp-top">
        <span class="dp-h">Payments ledger</span>
        <span class="dp-btn">✓ Approve</span>
      </div>
      <p class="dp-p">
        A refund posts only after the processor confirms settlement.<span class="dp-cite dp-cite--ok">1 ✓</span>
        Settlement closes <s>two</s> <span class="dp-ins">three</span> business days after capture.<span class="dp-cite dp-cite--ok">3 ✓</span>
      </p>
      <div class="dp-pop">
        <span class="dp-pop-path">ledger/config.py · line 37</span>
        <code>SETTLEMENT_WINDOW_DAYS = 3</code>
      </div>
    </>
  )}
  {kind === 'delivery' && (
    <>
      <div class="dp-axis"><span>turn 1</span><span>edit</span></div>
      <div class="dp-row">
        <span class="dp-lab">Pull</span>
        <span class="dp-track"><span class="dp-never">only if it asks</span><span class="dp-edit"></span></span>
      </div>
      <div class="dp-row">
        <span class="dp-lab">Standing instructions</span>
        <span class="dp-track"><span class="dp-dot dp-dot--start"></span><span class="dp-fade"></span><span class="dp-edit"></span></span>
      </div>
      <div class="dp-row">
        <span class="dp-lab">Push, with the file</span>
        <span class="dp-track"><span class="dp-dot dp-dot--late"></span><span class="dp-edit"></span></span>
      </div>
      <div class="dp-row">
        <span class="dp-lab">Gate before the edit</span>
        <span class="dp-track"><span class="dp-dot dp-dot--gate"></span><span class="dp-edit"></span></span>
      </div>
    </>
  )}
</div>

<style>
  .dp {
    position: relative;
    height: 100%;
    padding: 1rem 1.15rem;
    font-family: var(--font-sans);
    color: var(--text);
    background: var(--surface);
    overflow: hidden;
    font-size: 0.78rem;
    line-height: 1.6;
  }

  /* review */
  .dp-top { display: flex; align-items: center; justify-content: space-between; gap: 0.6rem; margin-bottom: 0.4rem; }
  .dp-h { min-width: 0; font-weight: 650; font-size: 0.86rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .dp-btn { flex: none; font-size: 0.66rem; font-weight: 600; padding: 0.1rem 0.5rem; border-radius: 6px; background: #F5D24A; color: #5C4600; }
  .dp-p { margin: 0; max-width: 34ch; color: var(--soft); }
  .dp-p s { color: var(--muted); }
  .dp-ins { background: var(--accent-soft); border-radius: 3px; padding: 0 2px; }
  .dp-cite { display: inline-block; margin-left: 3px; padding: 0 0.38rem; border: 1px solid color-mix(in srgb, var(--accent) 42%, transparent); border-radius: 5px; color: var(--accent); font-size: 0.64rem; font-weight: 650; line-height: 1.45; vertical-align: 1px; }
  .dp-cite--ok { background: var(--accent); border-color: var(--accent); color: var(--bg); }
  .dp-pop { position: absolute; right: 0.9rem; bottom: 0.8rem; width: 58%; display: flex; flex-direction: column; gap: 0.1rem; background: var(--surface-2); border: 1px solid var(--hairline-strong); border-radius: 8px; padding: 0.45rem 0.6rem; }
  .dp-pop-path { font-size: 0.62rem; color: var(--muted); }
  .dp-pop code { font-family: var(--font-mono); font-size: 0.62rem; color: var(--soft); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  /* delivery */
  .dp--delivery { display: flex; flex-direction: column; justify-content: center; font-size: 0.82rem; }
  .dp-axis { display: flex; justify-content: space-between; margin: 0 0 0.5rem 42%; font-size: 0.64rem; color: var(--muted); }
  .dp-row { display: flex; align-items: center; gap: 0.6rem; margin-top: 0.65rem; }
  .dp-lab { flex: 0 0 40%; font-size: 0.7rem; color: var(--soft); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .dp-track { position: relative; flex: 1; height: 1.1rem; border-bottom: 1px solid var(--hairline-strong); }
  .dp-edit { position: absolute; right: 8%; top: -0.2rem; bottom: -0.2rem; border-left: 2px solid var(--text); }
  .dp-never { position: absolute; left: 0; top: 0; font-size: 0.62rem; color: var(--muted); font-style: italic; }
  .dp-dot { position: absolute; top: 0.3rem; width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--accent); }
  .dp-dot--start { left: 0; }
  .dp-dot--late { left: 70%; }
  .dp-dot--gate { left: calc(92% - 0.5rem); }
  .dp-fade { position: absolute; left: 0.5rem; right: 8%; top: 0.5rem; height: 2px; background: linear-gradient(90deg, var(--accent), transparent); }
</style>
