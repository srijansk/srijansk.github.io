---
import '../styles/global.css';
import SocialIcons from '../components/SocialIcons.astro';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  pageType?: 'home' | 'inner' | 'post';
  /** Drafts build to their real URL but must never be indexed. */
  noindex?: boolean;
  ogType?: 'profile' | 'article';
  /** Path relative to the site root, e.g. /writing/foo/card.png */
  ogImage?: string;
  /** Link-preview title, when it should differ from the tab title. */
  ogTitle?: string;
  /** Describes ogImage for previews that expose alt text. */
  ogImageAlt?: string;
}

const {
  title,
  description = 'Srijan Saket builds the knowledge layer AI agents work from, as a founding engineer at Pavo AI. Before that, seven years scaling recommendation at ShareChat and code search at Sourcegraph. Essays on agents, retrieval and evaluation; design work on interfaces for AI.',
  canonical,
  pageType = 'home',
  noindex = false,
  ogType = 'profile',
  ogImage,
  ogTitle,
  ogImageAlt,
} = Astro.props;

const site = Astro.site?.toString().replace(/\/$/, '') ?? 'https://srijansaket.com';
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, site).toString();
const isPost = pageType === 'post';

// One list drives both navs; the current section is derived from the URL, so
// a post under /writing/ marks Writing and a piece under /design/ marks Design.
const path = Astro.url.pathname;
const NAV = [
  { href: '/', label: 'Home' },
  { href: '/writing/', label: 'Writing' },
  { href: '/design/', label: 'Design' },
  { href: '/talks/', label: 'Speaking' },
].map((n) => ({ ...n, current: n.href === '/' ? path === '/' : path.startsWith(n.href) }));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Srijan Saket" />
    <meta property="og:image" content={ogImage ? `${site}${ogImage}` : `${site}/srijan.png`} />
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    {ogImage && ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:site" content="@srijanskt2" />
    <meta name="twitter:creator" content="@srijanskt2" />

    <link rel="alternate" type="application/rss+xml" title="Srijan Saket — Writing" href="/rss.xml" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" as="image" href="/srijan.png" fetchpriority="high" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: 'Srijan Saket',
      url: 'https://srijansaket.com',
      image: 'https://srijansaket.com/srijan.png',
      jobTitle: 'Founding Engineer',
      worksFor: { '@type': 'Organization', name: 'Pavo AI' },
      alumniOf: [
        { '@type': 'Organization', name: 'Sourcegraph' },
        { '@type': 'Organization', name: 'ShareChat' },
        { '@type': 'Organization', name: 'Fidelity Investments' },
        { '@type': 'CollegeOrUniversity', name: 'IIT Kanpur' },
      ],
      sameAs: [
        'https://www.linkedin.com/in/srijansaket/',
        'https://x.com/srijanskt2',
        'https://github.com/srijansk',
        'https://scholar.google.com/citations?user=hheK6oIAAAAJ',
        'https://bitsnneurons.substack.com',
      ],
    })} />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <SocialIcons />
    <div class:list={['site', isPost && 'site--post']}>
      {isPost && (
        <header class="topbar">
          <a class="topbar-identity" href="/" aria-label="Home">
            <img class="topbar-avatar" src="/srijan.png" alt="" width="36" height="36" decoding="async" />
            <span class="topbar-name">Srijan Saket</span>
          </a>
          <nav class="topbar-nav" aria-label="Pages">
            {NAV.map((n) => <a href={n.href} aria-current={n.current ? 'page' : undefined}>{n.label}</a>)}
          </nav>
        </header>
      )}
      {!isPost && (
      <aside class="sidebar" aria-label="Profile">
        <a class="sidebar-avatar-link" href="/" aria-label="Home">
          <img
            class="sidebar-avatar"
            src="/srijan.png"
            alt="Portrait of Srijan Saket"
            width="96"
            height="96"
            decoding="async"
            fetchpriority="high"
          />
        </a>
        <a class="sidebar-name" href="/">Srijan Saket</a>
        <p class="sidebar-role">Founding engineer, Pavo AI</p>
        <p class="sidebar-location">Seattle</p>

        <nav class="sidebar-nav" aria-label="Pages">
          {NAV.map((n) => <a href={n.href} aria-current={n.current ? 'page' : undefined}>{n.label}</a>)}
        </nav>

        <nav class="sidebar-links" aria-label="Elsewhere">
          <a href="https://www.linkedin.com/in/srijansaket/" target="_blank" rel="noopener">LinkedIn</a>
          <a href="https://x.com/srijanskt2" target="_blank" rel="noopener">X</a>
          <a href="https://github.com/srijansk" target="_blank" rel="noopener">GitHub</a>
          <a href="https://scholar.google.com/citations?user=hheK6oIAAAAJ&hl=en" target="_blank" rel="noopener">Scholar</a>
          <a href="https://bitsnneurons.substack.com" target="_blank" rel="noopener">Newsletter</a>
        </nav>
        <a class="sidebar-mail" href="mailto:srijanskt@gmail.com">srijanskt@gmail.com</a>
      </aside>
      )}

      <main id="content">
        <script is:inline>
          // Interactive figures post their content height (public/writing/_figure.js);
          // size each iframe to fit so no viewport width or figure state clips it.
          window.addEventListener('message', function (e) {
            if (e.origin !== location.origin || !e.data || e.data.type !== 'figure-height') return;
            var frames = document.querySelectorAll('figure iframe');
            for (var i = 0; i < frames.length; i++) {
              var f = frames[i];
              if (f.contentWindow !== e.source) continue;
              f.style.height = (e.data.height + (f.offsetHeight - f.clientHeight)) + 'px';
            }
          });
        </script>
        <slot />
        <footer class="site-footer">
          <span>Srijan Saket, Seattle</span>
          <a href="mailto:srijanskt@gmail.com">Email</a>
          <a href="/rss.xml">RSS</a>
        </footer>
      </main>
    </div>
  </body>
</html>
