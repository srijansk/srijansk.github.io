---
import Layout from '../layouts/Layout.astro';
import HandoffLoop from '../components/HandoffLoop.astro';
import {
  getPublishedWriting,
  hrefFor,
  linkAttrs,
  isSelfHosted,
  readingTime,
  byline,
  seriesBlocks,
  type WritingEntry,
} from '../lib/writing';

// In the dev server, drafts are listed and badged so the page can be reviewed
// as it will land. A production build evaluates DEV to false and they vanish.
const all = await getPublishedWriting({ includeDrafts: import.meta.env.DEV });

const series = seriesBlocks(all);

const dateShort = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', timeZone: 'UTC' });

const groupedByYear = new Map<number, WritingEntry[]>();
for (const w of all) {
  const y = w.data.date.getUTCFullYear();
  if (!groupedByYear.has(y)) groupedByYear.set(y, []);
  groupedByYear.get(y)!.push(w);
}
const years = [...groupedByYear.keys()].sort((a, b) => b - a);
---

<Layout
  title="Writing — Srijan Saket"
  description="Essays by Srijan Saket on agents, retrieval and evaluation, plus older engineering stories."
  pageType="inner"
>
  <section class="page-intro">
    <h1 class="page-title">Writing</h1>
    <p class="page-lede">
      Essays on agents, retrieval and evaluation, plus older engineering stories. Long-form pieces
      are published here. I also co-write the infrastructure and AI newsletter
      <a href="https://bitsnneurons.substack.com" target="_blank" rel="noopener">Bits &amp; Neurons</a>
      with Vivek Chandela, and earlier posts appeared on the ShareChat engineering blog and Medium.
    </p>
    <HandoffLoop />
  </section>

  {series.map((s) => (
    <section class="section series-block" aria-labelledby={`series-${s.posts[0].id}`}>
      <p class="series-label">Series · {s.posts.length} parts</p>
      <h2 class="series-title" id={`series-${s.posts[0].id}`}>{s.name}</h2>
      {s.thesis && <p class="series-thesis">{s.thesis}</p>}
      <ol class="series-list">
        {s.posts.map((w) => {
          const minutes = readingTime(w.body);
          return (
            <li>
              <a class="series-item" href={hrefFor(w)} {...linkAttrs(w)}>
                <span class="series-item-title">
                  {w.data.title}
                  {w.data.draft && <span class="draft-pill">draft</span>}
                </span>
                <span class="series-item-teaser">{w.data.teaser}</span>
                <span class="series-item-meta">
                  {byline(w)}
                  <span class="sep">&middot;</span>
                  {dateShort.format(w.data.date)}
                  {minutes && <><span class="sep">&middot;</span>{minutes}</>}
                </span>
              </a>
            </li>
          );
        })}
      </ol>
    </section>
  ))}

  <section class="section" aria-labelledby="all-writing">
    <h2 class="section-title" id="all-writing">All writing</h2>
    {years.map((y) => (
      <div class="year-group">
        <h3 class="year-label">{y}</h3>
        <ul class="list-cards">
          {groupedByYear.get(y)!.map((w) => {
            const own = isSelfHosted(w);
            const minutes = own ? readingTime(w.body)?.replace(' read', '') : undefined;
            const image = w.data.cover ?? w.data.thumbnail;
            return (
              <li>
                <a class="list-card" href={hrefFor(w)} {...linkAttrs(w)}>
                  {image && (
                    <span class:list={['list-media', w.data.cover && 'list-media--figure']}>
                      <img src={image} alt="" width="400" height="250" loading="lazy" decoding="async" />
                    </span>
                  )}
                  <span class="list-body">
                    <span class="work-title">
                      {w.data.title}
                      {w.data.draft && <span class="draft-pill">draft</span>}
                    </span>
                    <span class="work-meta">
                      {dateShort.format(w.data.date)}
                      {minutes && <> · {minutes}</>}
                      {w.data.coauthors.length > 0 && <> · with {w.data.coauthors.join(' and ')}</>}
                      {own ? (w.data.series && <> · {w.data.series}</>) : <> · {w.data.publication}</>}
                    </span>
                    <span class="work-text work-text--3">{w.data.excerpt ?? w.data.teaser}</span>
                  </span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    ))}
  </section>

  <section class="section" aria-labelledby="subscribe">
    <h2 class="section-title" id="subscribe">Subscribe</h2>
    <p class="page-text">
      New essays appear in this site's feed. To follow it, add the address below to a feed
      reader such as NetNewsWire, Feedly or Inoreader. I also co-write the newsletter
      <a href="https://bitsnneurons.substack.com" target="_blank" rel="noopener">Bits &amp; Neurons on Substack</a>.
    </p>
    <div class="feed-copy">
      <code class="feed-url">https://srijansaket.com/rss.xml</code>
      <button type="button" class="feed-copy-btn" data-copy="https://srijansaket.com/rss.xml">Copy</button>
      <span class="feed-copy-status" aria-live="polite"></span>
    </div>
    <script>
      // Copy the feed address; where the clipboard is unavailable, select it instead.
      for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
        const status = button.parentElement?.querySelector('.feed-copy-status');
        button.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(button.dataset.copy ?? '');
            button.textContent = 'Copied';
            if (status) status.textContent = 'Feed address copied.';
          } catch {
            const code = button.parentElement?.querySelector('.feed-url');
            if (code) {
              const range = document.createRange();
              range.selectNodeContents(code);
              getSelection()?.removeAllRanges();
              getSelection()?.addRange(range);
            }
            button.textContent = 'Selected';
            if (status) status.textContent = 'Feed address selected; copy it with your keyboard.';
          }
          setTimeout(() => {
            button.textContent = 'Copy';
            if (status) status.textContent = '';
          }, 2500);
        });
      }
    </script>
  </section>
</Layout>
