---
import Layout from '../layouts/Layout.astro';
import {
  getPublishedWriting,
  hrefFor,
  linkAttrs,
  isSelfHosted,
  readingTime,
  byline,
  seriesBlocks,
  type WritingEntry,
} from '../lib/writing';

// In the dev server, drafts are listed and badged so the page can be reviewed
// as it will land. A production build evaluates DEV to false and they vanish.
const all = await getPublishedWriting({ includeDrafts: import.meta.env.DEV });

const series = seriesBlocks(all);

const dateShort = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', timeZone: 'UTC' });

const groupedByYear = new Map<number, WritingEntry[]>();
for (const w of all) {
  const y = w.data.date.getUTCFullYear();
  if (!groupedByYear.has(y)) groupedByYear.set(y, []);
  groupedByYear.get(y)!.push(w);
}
const years = [...groupedByYear.keys()].sort((a, b) => b - a);
---

<Layout
  title="Writing — Srijan Saket"
  description="Essays, engineering war stories, and technical deep-dives by Srijan Saket on retrieval, agent systems, and evaluation."
  pageType="inner"
>
  <section class="section lede">
    <h1>Writing</h1>
    <p class="hero-sub">
      Essays on retrieval, agent systems, and evaluation &mdash; plus older engineering war
      stories. Long-form pieces where the argument is mine are published here; I also co-write
      the infra + AI newsletter
      <a href="https://bitsnneurons.substack.com" target="_blank" rel="noopener">Bits &amp; Neurons</a>
      with Vivek Chandela. Earlier posts appeared on the ShareChat engineering blog and Medium.
    </p>
  </section>

  {series.map((s) => (
    <section class="section series-block" aria-labelledby={`series-${s.posts[0].id}`}>
      <span class="section-kicker">Series</span>
      <h2 id={`series-${s.posts[0].id}`}>{s.name}</h2>
      {s.thesis && <p class="series-thesis">{s.thesis}</p>}
      <ol class="series-list">
        {s.posts.map((w) => {
          const minutes = readingTime(w.body);
          return (
            <li>
              <a class="series-item" href={hrefFor(w)} {...linkAttrs(w)}>
                <span class="series-item-title">
                  {w.data.title}
                  {w.data.draft && <span class="draft-pill">draft</span>}
                </span>
                <span class="series-item-teaser">{w.data.teaser}</span>
                <span class="series-item-meta">
                  {byline(w)}
                  <span class="sep">&middot;</span>
                  {dateShort.format(w.data.date)}
                  {minutes && <><span class="sep">&middot;</span>{minutes}</>}
                </span>
              </a>
            </li>
          );
        })}
      </ol>
    </section>
  ))}

  {series.length > 0 && (
    <section class="section">
      <span class="section-kicker">Everything</span>
      <h2>All writing</h2>
    </section>
  )}

  {years.map((y) => (
    <section class="section year-group">
      <h2 class="year-label">{y}</h2>
      <ul class="writing-full-list">
        {groupedByYear.get(y)!.map((w) => {
          const href = hrefFor(w);
          const attrs = linkAttrs(w);
          const own = isSelfHosted(w);
          const minutes = own ? readingTime(w.body) : undefined;
          return (
            <li>
              {w.data.thumbnail && (
                <a class="writing-full-thumb" href={href} aria-label={`Open: ${w.data.title}`} {...attrs}>
                  <img
                    src={w.data.thumbnail}
                    alt=""
                    width="480"
                    height="270"
                    loading="lazy"
                    decoding="async"
                  />
                </a>
              )}
              <div class="writing-full-body">
                <span class="writing-meta">
                  {own ? byline(w) : w.data.publication}
                  <span class="sep">&middot;</span>
                  {dateShort.format(w.data.date)}
                  {minutes && <><span class="sep">&middot;</span>{minutes}</>}
                  {w.data.series && <><span class="sep">&middot;</span><span class="writing-series">{w.data.series}</span></>}
                  {w.data.draft && <span class="draft-pill">draft</span>}
                </span>
                <h3 class="writing-title">
                  <a href={href} {...attrs}>{w.data.title}</a>
                </h3>
                <p class="writing-excerpt">{w.data.excerpt ?? w.data.teaser}</p>
                <p class="writing-cta">
                  <a href={href} {...attrs}>
                    {own ? 'Read' : `Read on ${w.data.publication}`} &rarr;
                  </a>
                </p>
              </div>
            </li>
          );
        })}
      </ul>
    </section>
  ))}

  <section class="section">
    <h2>Subscribe</h2>
    <p>
      New posts here land in the <a href="/rss.xml">RSS feed</a>. For the newsletter, subscribe to
      <a href="https://bitsnneurons.substack.com" target="_blank" rel="noopener">Bits &amp; Neurons on Substack &rarr;</a>
    </p>
  </section>
</Layout>
