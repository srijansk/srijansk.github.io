---
import Layout from '../layouts/Layout.astro';
import DesignPreview from '../components/DesignPreview.astro';
import { getCollection } from 'astro:content';
import { surfaceLabel } from '../lib/design';

const pieces = (await getCollection('design'))
  .filter((d) => import.meta.env.DEV || !d.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

const monthYear = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', timeZone: 'UTC' });
---

<Layout
  title="Design — Srijan Saket"
  description="How Srijan Saket thinks about interfaces for AI: the ones people use to direct, check and correct agents, and the ones agents work through themselves."
  pageType="inner"
>
  <section class="page-intro">
    <h1 class="page-title">Design</h1>
    <p class="page-lede">
      How I think about interfaces for AI, on both sides of an agent. Some are for people: the
      places where someone directs an agent, checks what it produced and corrects it. Others have
      the agent as their user: what it is given, and when. The pieces here describe
      one loop. What a person approves on one side is what the next agent should receive on the
      other. Each has something you can operate.
    </p>
  </section>

  <section class="section" aria-label="Pieces">
    <div class="work-grid">
      {pieces.map((d) => (
        <a class="work-card" href={`/design/${d.id}/`}>
          <div class="work-media work-media--live"><DesignPreview kind={d.data.preview} /></div>
          <span class="work-title">{d.data.title}</span>
          <span class="work-meta">{surfaceLabel(d.data.surface)} · {monthYear.format(d.data.date)}</span>
          <span class="work-text work-text--3">{d.data.teaser ?? d.data.summary}</span>
        </a>
      ))}
    </div>
  </section>
</Layout>
