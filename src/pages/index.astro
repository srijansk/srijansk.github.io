---
import Layout from '../layouts/Layout.astro';
import DesignPreview from '../components/DesignPreview.astro';
import { getCollection } from 'astro:content';
import {
  getPublishedWriting,
  hrefFor,
  linkAttrs,
  isSelfHosted,
  readingTime,
} from '../lib/writing';

const allTalks = await getCollection('talks');
const talks = allTalks
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);

const allPubs = await getCollection('publications');
const papers = allPubs
  .filter((p) => p.data.type === 'paper')
  .sort((a, b) => b.data.year - a.data.year);
const otherPubs = allPubs.filter((p) => p.data.type !== 'paper');

// A shelf, not an archive: the four most recent featured pieces. /writing/ has everything.
const allWriting = await getPublishedWriting({ includeDrafts: import.meta.env.DEV });
const writing = allWriting.filter((w) => w.data.featured).slice(0, 4);

const design = (await getCollection('design'))
  .filter((d) => import.meta.env.DEV || !d.data.draft)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 2);

const monthYear = new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'short', timeZone: 'UTC' });
const talkType: Record<string, string> = {
  keynote: 'Keynote',
  talk: 'Talk',
  panel: 'Panel',
  tutorial: 'Tutorial',
  'pc-service': 'Programme committee',
  webinar: 'Webinar',
};
const designKind: Record<string, string> = { concept: 'Concept', principle: 'Principle', study: 'Study' };

// What the essays argue, one line each. Every belief links to the piece that
// makes the case, and the note under it gives the number or finding behind it.
const beliefs = [
  {
    text: 'Evidence is only useful if it survives every handoff.',
    href: '/writing/retrieval-is-not-delivery/',
    source: 'Retrieval Is Not Delivery',
    note: 'Of the excerpts one agent had read, 22% reached the next agent intact. A structured record, with the changes around it, took that to 60%.',
  },
  {
    text: 'An agent is finished when it can prove it, not when it says so.',
    href: '/writing/completion-is-a-proof/',
    source: 'Completion Is a Proof, Not a Status',
    note: 'A tool call can end while the command it started is still running. Four clocks have to settle first.',
  },
  {
    text: 'Measure how much a benchmark moves before claiming it improved.',
    href: '/writing/your-eval-has-a-noise-floor/',
    source: 'Your Eval Has a Noise Floor',
    note: 'One unchanged configuration scored 33, 27, 17 and 25 claims out of sixty.',
  },
  {
    text: 'Choosing what an agent sees is a ranking problem.',
    href: '/writing/agent-context-is-a-recommendation-problem/',
    source: 'Agent Context Is a Recommendation Problem',
    note: 'Picking a small, ordered set under a hard budget when nobody asked is a close cousin of what recommenders have worked on for twenty years.',
  },
  {
    text: 'An agent forgets things it is still holding, so write them down when it sees them.',
    href: '/writing/context-aging/',
    source: 'Context Aging',
    note: 'An agent read a two-step rule in its first minute and drafted it, more than twenty minutes later, as one step.',
  },
  {
    text: 'Anything an agent writes should show what each claim is made from.',
    href: '/design/reviewing-what-an-agent-wrote/',
    source: 'Reviewing what an agent wrote',
    note: 'Citations that open the exact source line, and human edits that survive the next regeneration.',
  },
];
---

<Layout title="Srijan Saket" pageType="home" ogImage="/card.png">
  <section class="intro">
    <h1 class="intro-title">I build the knowledge layer AI agents work from.</h1>
    <p class="intro-text">
      Founding engineer at Pavo AI. Before that, seven years scaling recommendation at ShareChat
      from one million users to two hundred million, then code search at Sourcegraph. I write
      about what agents lose between finding something and using it, and I design the interfaces
      people use to check an agent's work.
    </p>
    <p class="intro-facts">
      <a href="#papers">Papers at WWW, RecSys, SIGIR and CIKM</a>
      <span aria-hidden="true">·</span>
      <a href="/talks/2023-12-fire-keynote/">Keynote at FIRE 2023</a>
      <span aria-hidden="true">·</span>
      <a href="#open-source">Open source: crewlore</a>
    </p>
  </section>

  <section class="section beliefs" aria-labelledby="beliefs-title">
    <h2 class="section-title" id="beliefs-title">What I believe about building with AI</h2>
    <ol class="belief-list">
      {beliefs.map((b, i) => (
        <li>
          <span class="belief-text">{b.text}</span>
          <a class="cite" href={b.href} aria-describedby={`belief-${i}`}>
            <span class="cite-n">{i + 1}</span>
            <span class="cite-pop" role="tooltip" id={`belief-${i}`}>
              <b>{b.source}</b>
              {b.note}
            </span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="section" id="writing" aria-labelledby="writing-title">
    <div class="section-head">
      <h2 class="section-title" id="writing-title">Writing</h2>
      <a class="section-more" href="/writing/">All writing</a>
    </div>
    <div class="work-grid">
      {writing.map((w) => {
        const own = isSelfHosted(w);
        const minutes = own ? readingTime(w.body)?.replace(' read', '') : undefined;
        const image = w.data.cover ?? w.data.thumbnail;
        return (
          <a class="work-card" href={hrefFor(w)} {...linkAttrs(w)}>
            {image && (
              <span class:list={['work-media', w.data.cover && 'work-media--figure']}>
                <img src={image} alt="" width="480" height="300" loading="lazy" decoding="async" />
              </span>
            )}
            <span class="work-title">{w.data.title}</span>
            <span class="work-meta">
              {monthYear.format(w.data.date)}
              {minutes && <> · {minutes}</>}
              {w.data.coauthors.length > 0 && <> · with {w.data.coauthors.join(' and ')}</>}
              {!own && <> · {w.data.publication}</>}
            </span>
            <span class="work-text">{w.data.teaser}</span>
          </a>
        );
      })}
    </div>
  </section>

  {design.length > 0 && (
    <section class="section" id="design" aria-labelledby="design-title">
      <div class="section-head">
        <h2 class="section-title" id="design-title">Design</h2>
        <a class="section-more" href="/design/">All design</a>
      </div>
      <div class="work-grid">
        {design.map((d) => (
          <a class="work-card" href={`/design/${d.id}/`}>
            <span class="work-media work-media--live"><DesignPreview kind={d.data.preview} /></span>
            <span class="work-title">{d.data.title}</span>
            <span class="work-meta">{designKind[d.data.kind]} · {monthYear.format(d.data.date)}</span>
            <span class="work-text">{d.data.summary}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="section" id="open-source" aria-labelledby="oss-title">
    <div class="section-head">
      <h2 class="section-title" id="oss-title">Open source</h2>
      <a class="section-more" href="https://github.com/srijansk" target="_blank" rel="noopener">GitHub</a>
    </div>
    <ul class="row-list">
      <li>
        <a class="row-title" href="https://github.com/srijansk/crewlore" target="_blank" rel="noopener">crewlore</a>
        <p class="row-text">
          A local-first compiler that turns coding-agent sessions and agent-authored pull requests
          into a plaintext, citable team-knowledge book in your git repo. Every claim quotes the
          exact source line it came from, and records whether the team adopted it or tried it and
          declined: a field added after measuring, on 120 real agent pull requests, that without it
          the rejected approach was stored as current practice in roughly half of the declined ones.
          Alpha, on PyPI: <code>pipx install crewlore</code>.
        </p>
      </li>
      <li>
        <a class="row-title" href="https://github.com/srijansk/agent-relay" target="_blank" rel="noopener">agent-relay</a>
        <p class="row-text">
          Multi-agent workflows that learn from their own past runs. Plans, reviews, build logs and
          audits live in your git repo as markdown, and <code>relay distill --llm</code> turns past
          reviewer rejections into lessons the next planner reads. Alpha.
        </p>
      </li>
    </ul>
  </section>

  <section class="section" id="papers" aria-labelledby="papers-title">
    <div class="section-head">
      <h2 class="section-title" id="papers-title">Papers</h2>
      <a class="section-more" href="https://scholar.google.com/citations?user=hheK6oIAAAAJ&hl=en" target="_blank" rel="noopener">Google Scholar</a>
    </div>
    <ul class="row-list row-list--tight">
      {papers.map((p) => {
        const href = p.data.url ?? p.data.arxiv ?? (p.data.doi ? `https://doi.org/${p.data.doi}` : p.data.pdf);
        return (
          <li>
            {href
              ? <a class="row-title" href={href} target="_blank" rel="noopener">{p.data.title}</a>
              : <span class="row-title">{p.data.title}</span>}
            <span class="row-meta">{p.data.venue}</span>
          </li>
        );
      })}
      {otherPubs.map((p) => (
        <li>
          {p.data.url
            ? <a class="row-title" href={p.data.url} target="_blank" rel="noopener">{p.data.title}</a>
            : <span class="row-title">{p.data.title}</span>}
          <span class="row-meta">{p.data.type === 'patent' ? 'Patent' : 'Book'} · {p.data.venue}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="section" id="speaking" aria-labelledby="speaking-title">
    <div class="section-head">
      <h2 class="section-title" id="speaking-title">Speaking</h2>
      <a class="section-more" href="/talks/">All talks</a>
    </div>
    <ul class="row-list row-list--tight">
      {talks.map((t) => (
        <li>
          <a class="row-title" href={`/talks/${t.id}/`}>{t.data.title}</a>
          <span class="row-meta">{talkType[t.data.type] ?? t.data.type} · {t.data.venue} · {monthYear.format(t.data.date)}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="section" id="career" aria-labelledby="career-title">
    <h2 class="section-title" id="career-title">Career</h2>
    <ul class="timeline">
      <li>
        <span class="dates">2025–now</span>
        <span class="role"><strong>Pavo AI</strong>, founding engineer<span class="desc">The knowledge layer AI agents work from; building the founding engineering team across the US, London and India.</span></span>
      </li>
      <li>
        <span class="dates">2024–2025</span>
        <span class="role"><strong>Sourcegraph</strong>, machine learning engineer<span class="desc">LLM-driven ranking and retrieval for code search over large codebases.</span></span>
      </li>
      <li>
        <span class="dates">2017–2024</span>
        <span class="role"><strong>ShareChat</strong>, staff machine learning engineer<span class="desc">Scaled the recommender system from one million users to two hundred million; led a team of 18 to 20 engineers across ranking, moderation and feature pipelines.</span></span>
      </li>
      <li>
        <span class="dates">2016–2017</span>
        <span class="role"><strong>Fidelity Investments</strong>, data scientist</span>
      </li>
      <li>
        <span class="dates">2011–2016</span>
        <span class="role"><strong>IIT Kanpur</strong>, BS and MS in Mathematics and Scientific Computing</span>
      </li>
    </ul>
  </section>

  <section class="section contact" aria-labelledby="contact-title">
    <h2 class="section-title" id="contact-title">Get in touch</h2>
    <p>
      Email <a href="mailto:srijanskt@gmail.com">srijanskt@gmail.com</a>, or message me on
      <a href="https://x.com/srijanskt2" target="_blank" rel="noopener">X</a> or
      <a href="https://www.linkedin.com/in/srijansaket/" target="_blank" rel="noopener">LinkedIn</a>.
      I'm glad to talk about agents, retrieval, evaluation, and interfaces for AI.
    </p>
  </section>
</Layout>
