---
import Layout from '../../layouts/Layout.astro';
import { render } from 'astro:content';
import {
  getAllWriting,
  isSelfHosted,
  byline,
  readingTime,
  seriesSiblings,
  slugFor,
  SERIES_THESIS,
  type WritingEntry,
} from '../../lib/writing';

/**
 * Only self-hosted entries get a page here. An entry that carries a `url`
 * already has a home somewhere else; minting a second one would split its
 * canonical identity for no reader benefit.
 */
export async function getStaticPaths() {
  const all = await getAllWriting();
  return all.filter(isSelfHosted).map((post) => ({
    params: { slug: slugFor(post) },
    props: { post },
  }));
}

const { post } = Astro.props as { post: WritingEntry };
const { Content, headings } = await render(post);

// A contents list earns its place once a post has enough sections to get
// lost in. Below that it is furniture. H2 only — H3s are rules inside a
// section, not destinations.
const toc = headings.filter((h) => h.depth === 2);
const showToc = toc.length >= 6;

const dateLong = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});

const minutes = readingTime(post.body);
const siblings = await seriesSiblings(post);
const showSeries = siblings.length > 1;
const position = showSeries ? siblings.findIndex((s) => s.id === post.id) + 1 : 0;
---

<Layout
  title={`${post.data.title} — Srijan Saket`}
  description={post.data.dek ?? post.data.teaser}
  pageType="inner"
  noindex={post.data.draft}
  ogType="article"
  ogImage={post.data.socialImage ?? post.data.thumbnail}
>
  <article class="post">
    <header class="post-header">
      {post.data.draft && (
        <p class="post-draft-flag">
          Draft &middot; unlisted and not indexed. Reachable only by direct link.
        </p>
      )}

      {showSeries && (
        <p class="post-series-kicker">
          {post.data.series} &middot; part {position} of {siblings.length}
        </p>
      )}

      <h1>{post.data.title}</h1>

      {post.data.dek && <p class="post-dek">{post.data.dek}</p>}

      <p class="post-meta">
        <span>{byline(post)}</span>
        <span class="sep">&middot;</span>
        <time datetime={post.data.date.toISOString()}>{dateLong.format(post.data.date)}</time>
        {minutes && <><span class="sep">&middot;</span><span>{minutes}</span></>}
      </p>

      {post.data.tags.length > 0 && (
        <ul class="post-tags">
          {post.data.tags.map((tag) => <li>{tag}</li>)}
        </ul>
      )}
    </header>

    {post.data.thumbnail && (
      <img
        class="post-plate"
        src={post.data.thumbnail}
        alt=""
        width="1200"
        height="630"
        fetchpriority="high"
        decoding="async"
      />
    )}

    {showToc && (
      <nav class="post-toc" aria-label="Contents">
        <h2>Contents</h2>
        <ol>
          {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
        </ol>
      </nav>
    )}

    <div class="prose">
      <Content />
    </div>

    {showSeries && (
      <nav class="post-series-nav" aria-label={`${post.data.series} series`}>
        <h2>{post.data.series}</h2>
        {post.data.series && SERIES_THESIS[post.data.series] && (
          <p class="post-series-thesis">{SERIES_THESIS[post.data.series]}</p>
        )}
        <ol>
          {siblings.map((sibling) => (
            <li aria-current={sibling.id === post.id ? 'page' : undefined}>
              {sibling.id === post.id ? (
                <span class="current">{sibling.data.title}</span>
              ) : (
                <a href={`/writing/${slugFor(sibling)}/`}>{sibling.data.title}</a>
              )}
            </li>
          ))}
        </ol>
      </nav>
    )}

    <p class="post-back"><a href="/writing/">&larr; All writing</a></p>
  </article>
</Layout>
