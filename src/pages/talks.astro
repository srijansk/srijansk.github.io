---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const all = (await getCollection('talks')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const dateLong = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  timeZone: 'UTC',
});

const talkTypeLabel: Record<string, string> = {
  keynote: 'Keynote',
  talk: 'Talk',
  panel: 'Panel',
  tutorial: 'Tutorial',
  'pc-service': 'Programme committee',
  webinar: 'Webinar',
};

const groupedByYear = new Map<number, typeof all>();
for (const t of all) {
  const y = t.data.date.getUTCFullYear();
  if (!groupedByYear.has(y)) groupedByYear.set(y, [] as any);
  groupedByYear.get(y)!.push(t as any);
}
const years = [...groupedByYear.keys()].sort((a, b) => b - a);
---

<Layout
  title="Speaking — Srijan Saket"
  description="Keynotes, talks, workshop presentations and programme-committee service by Srijan Saket."
  pageType="inner"
>
  <section class="page-intro">
    <h1 class="page-title">Speaking</h1>
    <p class="page-lede">
      Keynotes, paper presentations, workshop talks and programme-committee service. Each entry
      links to a page with the slides.
    </p>
  </section>

  <section class="section">
    {years.map((y) => (
      <div class="year-group">
        <h2 class="year-label">{y}</h2>
        <ul class="row-list">
          {groupedByYear.get(y)!.map((t) => (
            <li>
              <a class="row-title" href={`/talks/${t.id}/`}>{t.data.title}</a>
              <span class="row-meta">
                {talkTypeLabel[t.data.type] ?? t.data.type} · {t.data.venue}{t.data.location ? `, ${t.data.location}` : ''} · {dateLong.format(t.data.date)}
              </span>
              {t.data.abstract && <p class="row-text">{t.data.abstract}</p>}
              {(t.data.slides || t.data.video) && (
                <p class="row-links">
                  {t.data.slides && <a href={t.data.slides} target="_blank" rel="noopener">Slides</a>}
                  {t.data.video && <a href={t.data.video} target="_blank" rel="noopener">Video</a>}
                </p>
              )}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>
</Layout>
